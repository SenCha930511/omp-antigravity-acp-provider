{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["extension/**/*.ts", "extension/**/*.d.mts", "marketplace/**/*.ts", "scripts/typecheck-contracts.ts"]
}
