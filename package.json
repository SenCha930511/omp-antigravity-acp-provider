{
  "name": "omp-antigravity-acp-provider",
  "version": "0.2.1",
  "ompAcpBundle": 1,
  "description": "Google Antigravity ACP provider for Oh My Pi (OMP), with tool bridging and per-model thinking; derived from zacbemis/pi-antigravity-acp-provider",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SenCha930511/omp-antigravity-acp-provider.git"
  },
  "homepage": "https://github.com/SenCha930511/omp-antigravity-acp-provider#readme",
  "bugs": {
    "url": "https://github.com/SenCha930511/omp-antigravity-acp-provider/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extension/",
    "licenses/",
    "README.md",
    "AGENT_INSTALL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node scripts/test.mjs",
    "test:packed": "node scripts/build.mjs && node scripts/test-packed.mjs",
    "test:marketplace": "node scripts/test-marketplace.mjs",
    "test:commands": "bun scripts/test-tool-command.ts",
    "test:auth": "bun scripts/test-auth-command.ts",
    "test:cleanup": "node scripts/build.mjs && node scripts/test-cleanup-runtime.ts",
    "test:continuity": "node scripts/build.mjs && node scripts/test-request-continuity.ts && node scripts/test-graceful-cancellation.ts",
    "test:omp-compaction": "bun scripts/test-omp-compaction.ts",
    "test:omp-sessions": "node scripts/build.mjs && node scripts/test-omp-session-switch.ts",
    "test:omp-rollover": "node scripts/build.mjs && node scripts/test-context-rollover.ts",
    "test:omp-builtin-usage": "node scripts/build.mjs && node scripts/test-omp-builtin-usage.mjs",
    "test:managed-context": "node scripts/test-with-managed-context.mjs",
    "check:versions": "node scripts/check-release-versions.mjs",
    "typecheck": "tsc -p tsconfig.contracts.json",
    "release:bump": "node scripts/bump-release.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:cleanup && npm run test:continuity && npm run test:tools && npm run test:wire && npm run test:wire-tools && npm run test:wire-relay && npm run test:wire-tools-list && npm run test:graph && npm run test:commands && npm run test:auth && npm run test:runtime-source && npm run test:managed && npm run test:close-session && npm run test:omp-sessions && npm run test:omp-rollover && npm run test:omp-builtin-usage && npm run test:managed-context && npm run test:packed",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:graph": "bun scripts/test-load-graph.ts",
    "test:tools": "node scripts/test-tool-set-sync.ts",
    "test:runtime-source": "node scripts/test-acp-runtime-source.ts",
    "test:managed": "bun scripts/test-managed-runtime.ts",
    "test:close-session": "bun scripts/test-close-session.mjs",
    "probe:agy": "node scripts/probe-agy-limits.ts",
    "test:wire": "node scripts/test-wire-acp.ts",
    "test:wire-tools": "node scripts/test-wire-tools.ts",
    "test:wire-relay": "node scripts/test-wire-relay.ts",
    "test:wire-tools-list": "node scripts/test-wire-tools-list.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "0.28.2",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.36",
    "typescript": "^5.9.3",
    "unzipper": "0.12.5",
    "zod": "4.6.5"
  },
  "keywords": [
    "pi-package",
    "extension",
    "plugin",
    "omp",
    "oh-my-pi",
    "antigravity",
    "acp",
    "gemini"
  ]
}
